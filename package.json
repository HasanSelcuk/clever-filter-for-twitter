{
  "name": "clever-filter-for-x",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that checks posts on X with a decision model and hides, bookmarks or likes them by your rules.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --zip",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && node test/e2e/run.mjs",
    "check": "npm run typecheck && npm test",
    "test:server": "node scripts/build.mjs && node test/e2e/real-server.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.11.0",
    "playwright-core": "1.56.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
